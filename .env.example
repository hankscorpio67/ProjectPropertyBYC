# ============================================================
# Strategic Property AI Assistant - Configuration
# ============================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# ----- Required -----

# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Brave Search API key (https://api.search.brave.com/app/keys)
# Free tier: 2,000 searches/month - sufficient for this use case
BRAVE_SEARCH_API_KEY=BSA...

# ----- Optional: Enhanced Voice -----

# OpenAI TTS for higher-quality car audio (optional)
# If not set, browser SpeechSynthesis is used (free, works fine)
OPENAI_API_KEY=sk-...

# ----- App Settings -----

# Port to run the app on
PORT=8000

# Claude model to use
# claude-sonnet-4-6 = fast + capable (recommended)
# claude-opus-4-6   = most capable, slower, costs more
CLAUDE_MODEL=claude-sonnet-4-6

# Directory for storing project data and uploads
DATA_DIR=./data

# Max file upload size in megabytes
MAX_UPLOAD_SIZE_MB=50

# Number of web search results to inject into context
SEARCH_RESULTS_COUNT=5

# Number of recent messages to include verbatim in context
CONTEXT_MESSAGES=15

# Number of document chunks to retrieve per query
RETRIEVAL_CHUNKS=6
